{
  "expo": {
    "name": "1 Futur Chez Vous",
    "slug": "1-futur-chez-vous",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "onefcv",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#071F36",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.onefcv.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "1 Futur Chez Vous a besoin d'accéder à vos photos pour illustrer vos annonces immobilières.",
        "NSCameraUsageDescription": "1 Futur Chez Vous a besoin d'accéder à votre appareil photo pour prendre des photos de vos biens."
      }
    },
    "android": {
      "package": "com.onefcv.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#071F36"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "1 Futur Chez Vous a besoin d'accéder à vos photos pour illustrer vos annonces immobilières.",
          "cameraPermission": "1 Futur Chez Vous a besoin d'accéder à votre appareil photo pour prendre des photos de vos biens."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#071F36"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": ""
      }
    }
  }
}
